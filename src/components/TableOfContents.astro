---
// Floating table of contents: a tab on the left edge that opens a panel of
// the post's h2/h3 headings with one click and closes with one click.
// Rendered server-side so the links are in the HTML for search engines.
import type { MarkdownHeading } from 'astro';
interface Props { headings: MarkdownHeading[]; }
const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{items.length > 1 && (
  <nav class="toc" aria-label="Table of contents" data-toc>
    <button type="button" class="toggle" aria-expanded="false" aria-controls="toc-panel" title="Table of contents" data-toc-toggle>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 6h16M4 12h10M4 18h13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
      <span class="label">Contents</span>
    </button>
    <div id="toc-panel" class="panel" hidden data-toc-panel>
      <div class="head">
        <p class="title">Table of Contents</p>
        <button type="button" class="close" aria-label="Close table of contents" data-toc-close>×</button>
      </div>
      <ol>
        {items.map((h) => (
          <li class:list={[`d${h.depth}`]}><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ol>
    </div>
  </nav>
)}
<script>
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  if (toc) {
    const toggle = toc.querySelector<HTMLButtonElement>('[data-toc-toggle]')!;
    const panel = toc.querySelector<HTMLElement>('[data-toc-panel]')!;
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const narrow = window.matchMedia('(max-width: 900px)');

    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toc.classList.toggle('open', open);
    };
    toggle.addEventListener('click', () => setOpen(panel.hidden));
    toc.querySelector('[data-toc-close]')?.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
    // On small screens the panel covers the article, so close it after a jump.
    links.forEach((a) => a.addEventListener('click', () => { if (narrow.matches) setOpen(false); }));

    // Highlight the section currently being read: the last heading that has
    // scrolled past a line near the top of the screen.
    const pairs = links
      .map((a) => [a, document.getElementById(decodeURIComponent(a.hash.slice(1)))] as const)
      .filter((pair): pair is readonly [HTMLAnchorElement, HTMLElement] => pair[1] !== null);
    let ticking = false;
    const update = () => {
      ticking = false;
      let current: HTMLAnchorElement | undefined;
      for (const [a, el] of pairs) {
        if (el.getBoundingClientRect().top <= 140) current = a;
        else break;
      }
      links.forEach((a) => a.classList.toggle('active', a === current));
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }
</script>
<style>
  .toc { position: fixed; left: 0; top: 9rem; z-index: 30; }
  .toggle {
    display: flex; align-items: center; gap: .45rem; cursor: pointer;
    background: var(--accent); color: #fff; border: 0; border-radius: 0 6px 6px 0;
    padding: .6rem .8rem .6rem .7rem; font: 600 .72rem var(--font); text-transform: uppercase; letter-spacing: .04em;
    box-shadow: 0 3px 12px rgb(0 0 0 / .18);
  }
  .toggle:hover { background: var(--accent-dark); }
  .open .toggle { visibility: hidden; }
  /* Between phone and wide desktop the page margin is narrow: icon-only tab so it never covers the article. */
  @media (min-width: 901px) and (max-width: 1439px) {
    .toggle { padding: .65rem .6rem; }
    .label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  }
  .panel {
    position: absolute; left: 0; top: 0; width: 19rem; max-height: calc(100vh - 11rem); overflow-y: auto;
    background: #fff; border: 1px solid var(--border); border-left: 4px solid var(--accent);
    border-radius: 0 6px 6px 0; box-shadow: 0 8px 30px rgb(0 0 0 / .18);
  }
  .panel[hidden] { display: none; }
  .head { position: sticky; top: 0; display: flex; justify-content: space-between; align-items: center; background: #fff; border-bottom: 1px solid var(--border); padding: .75rem .9rem .6rem 1rem; }
  .title { margin: 0; font-weight: 700; font-size: .8rem; text-transform: uppercase; letter-spacing: .04em; color: var(--text); }
  .close { border: 0; background: none; cursor: pointer; font-size: 1.4rem; line-height: 1; color: var(--muted); padding: 0 .2rem; }
  .close:hover { color: var(--accent); }
  ol { list-style: none; margin: 0; padding: .5rem 0 .8rem; }
  li a { display: block; padding: .3rem 1rem; font-size: .78rem; line-height: 1.4; color: var(--body); border-left: 3px solid transparent; }
  li.d3 a { padding-left: 1.9rem; font-size: .73rem; color: var(--muted); }
  li a:hover { color: var(--accent); }
  li a.active { color: var(--accent); font-weight: 600; border-left-color: var(--accent); background: #fdf0f0; }
  @media (max-width: 900px) {
    .toc { top: auto; bottom: 1.2rem; left: 1rem; }
    .toggle { border-radius: 6px; }
    .panel { position: fixed; left: .75rem; right: .75rem; bottom: .75rem; top: auto; width: auto; max-height: 70vh; border-radius: 8px; }
  }
</style>
