---
import FormattedDate from '../FormattedDate.astro';
import { postUrl, type Post } from '../../lib/posts';
interface Props { posts: Post[]; }
const { posts } = Astro.props;
---
{posts.length > 0 && (
  <div class="trending" data-trending>
    <span class="label">
      <svg viewBox="0 0 24 24" width="10" height="10" aria-hidden="true"><path fill="currentColor" d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>
      Trending
    </span>
    <div class="items">
      {posts.map((p, i) => (
        <p class="item" hidden={i > 0}><a href={postUrl(p)}>{p.data.title}</a> <FormattedDate date={p.data.pubDate} /></p>
      ))}
    </div>
    {posts.length > 1 && (
      <div class="nav">
        <button type="button" data-dir="-1" aria-label="Previous">‹</button>
        <button type="button" data-dir="1" aria-label="Next">›</button>
      </div>
    )}
  </div>
)}
<script>
  document.querySelectorAll<HTMLElement>('[data-trending]').forEach((bar) => {
    const items = [...bar.querySelectorAll<HTMLElement>('.item')];
    let i = 0;
    const show = (n: number) => { i = (n + items.length) % items.length; items.forEach((el, k) => (el.hidden = k !== i)); };
    bar.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => show(i + Number(b.dataset.dir))));
    if (items.length > 1) setInterval(() => { if (!bar.matches(':hover')) show(i + 1); }, 5000);
  });
</script>
<style>
  .trending { display: flex; align-items: stretch; background: #fff; border: 1px solid var(--border); margin-bottom: 1.2rem; min-height: 2.3rem; }
  .label { display: flex; align-items: center; gap: .35rem; background: var(--accent); color: #fff; font-size: .62rem; font-weight: 700; text-transform: uppercase; padding: 0 .9rem; flex: none; }
  .items { flex: 1; min-width: 0; display: flex; align-items: center; padding: 0 .8rem; }
  .item { margin: 0; font-size: .75rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .item a { color: var(--text); }
  .item a:hover { color: var(--accent); }
  .item :global(time) { font-size: .62rem; color: var(--muted); margin-left: .4rem; }
  .nav { display: flex; flex: none; }
  button { width: 2.2rem; border: 0; border-left: 1px solid var(--border); background: #fff; cursor: pointer; font-size: 1rem; color: var(--text); }
  button:hover { color: var(--accent); }
</style>
