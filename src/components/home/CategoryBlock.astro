---
// One homepage block: a big lead post, then three compact rows.
import Thumb from '../Thumb.astro';
import Byline from '../Byline.astro';
import Stars from '../Stars.astro';
import Icon from '../Icon.astro';
import { postUrl, type Post } from '../../lib/posts';
import { overallScore } from '../../lib/review';
import { categorySlug } from '../../config';
interface Props { title: string; highlight: string; icon: string; href?: string; posts: Post[]; }
const { title, highlight, icon, href, posts } = Astro.props;
const [lead, ...rest] = posts.slice(0, 4);
---
<section class="block">
  <h2 class="section-title">
    <span class="plain"><Icon name={icon} /> {title}</span>{href ? <a href={href}>{highlight}</a> : highlight}
  </h2>
  <article class="lead">
    <a class="img" href={postUrl(lead)} tabindex="-1" aria-hidden="true">
      <Thumb post={lead} ratio="2 / 1" />
      <span class="cat">{lead.data.category}</span>
    </a>
    <h3><a href={postUrl(lead)}>{lead.data.title}</a></h3>
    <Byline post={lead} />
    <p class="excerpt">{lead.data.description}</p>
  </article>
  {rest.map((p) => (
    <a class="row" href={postUrl(p)}>
      <Thumb post={p} width="5.5rem" />
      <span>
        <span class="t">{p.data.title}</span>
        {p.data.review && <Stars percent={overallScore(p.data.review.criteria, p.data.review.score)} color="red" size=".75rem" />}
      </span>
    </a>
  ))}
</section>
<style>
  .section-title { gap: .4rem; }
  .section-title .plain { display: inline-flex; align-items: center; gap: .4rem; }
  .section-title a { color: var(--accent); }
  .img { display: block; position: relative; }
  .cat { position: absolute; left: .6rem; bottom: 0; background: var(--accent); color: #fff; font-size: .66rem; font-weight: 600; text-transform: uppercase; padding: .1rem .45rem; }
  h3 { font-size: 1.1rem; font-weight: 700; line-height: 1.4; margin: .9rem 0 0; }
  h3 a, .row { color: var(--text); }
  h3 a:hover, .row:hover .t { color: var(--accent); }
  .excerpt { font-size: .95rem; line-height: 1.65; color: #4b5563; margin: 0 0 1.2rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .row { display: flex; gap: .8rem; align-items: flex-start; margin-bottom: 1.1rem; }
  .t { display: block; font-size: .92rem; font-weight: 500; line-height: 1.45; margin-bottom: .3rem; }
</style>
