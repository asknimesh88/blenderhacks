---
import Thumb from './Thumb.astro';
import Stars from './Stars.astro';
import FormattedDate from './FormattedDate.astro';
import { postUrl, type Post } from '../lib/posts';
import { overallScore } from '../lib/review';
import { categorySlug } from '../config';
interface Props { post: Post; }
const { post } = Astro.props;
const { title, description, pubDate, category, review } = post.data;
---
<article class="card">
  <a href={postUrl(post)} class="img" tabindex="-1" aria-hidden="true">
    <Thumb post={post} ratio="16 / 10" />
    {review && <span class="score">{overallScore(review.criteria, review.score)}<sup>%</sup></span>}
  </a>
  <a class="cat" href={`/category/${categorySlug(category)}/`}>{category}</a>
  <h3><a href={postUrl(post)}>{title}</a></h3>
  <p class="meta"><FormattedDate date={pubDate} />{review && <Stars percent={overallScore(review.criteria, review.score)} size=".72rem" />}</p>
  <p class="desc">{description}</p>
</article>
<style>
  .img { display: block; position: relative; margin-bottom: .8rem; }
  .score { position: absolute; right: 0; bottom: 0; background: var(--score); color: #fff; font-weight: 700; font-size: .9rem; padding: .35rem .6rem; }
  .score sup { font-size: .6em; }
  .cat { display: inline-block; background: var(--accent); color: #fff; font-size: .6rem; font-weight: 600; text-transform: uppercase; padding: .15rem .5rem; letter-spacing: .04em; }
  .cat:hover { color: #fff; background: var(--accent-dark); }
  h3 { font-size: 1.05rem; font-weight: 700; margin: .5rem 0 .3rem; line-height: 1.35; }
  h3 a { color: var(--text); }
  h3 a:hover { color: var(--accent); }
  .meta { display: flex; gap: .7rem; align-items: center; font-size: .7rem; color: var(--muted); margin: 0 0 .4rem; }
  .desc { font-size: .82rem; margin: 0; line-height: 1.6; }
</style>
