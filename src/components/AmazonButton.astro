---
import { amazonUrl } from '../lib/amazon';
interface Props { asin?: string; query?: string; label?: string; }
const { asin, query, label = 'Check price on Amazon' } = Astro.props;
---
<a class="btn amazon" href={amazonUrl({ asin, query })} rel="sponsored nofollow noopener" target="_blank">{label}</a>
<style>
  .amazon { font-size: .75rem; padding: .6rem 1.1rem; }
</style>
