---
// A product card for roundups and guides: optional rank, score, stars and
// rating bars, pros/cons and a buy button. No images, and no prices (Amazon's rules).
import AmazonButton from './AmazonButton.astro';
import Stars from './Stars.astro';
import ScoreBars from './review/ScoreBars.astro';
import ProsCons from './review/ProsCons.astro';
import { overallScore, type Criterion } from '../lib/review';

interface Props {
  name: string;
  asin?: string;
  query?: string;
  bestFor?: string;
  rank?: number;
  score?: number;          // percent; defaults to the criteria average
  criteria?: Criterion[];  // e.g. [{ label: 'Ease of cleaning', score: 90 }]
  pros?: string[];
  cons?: string[];
}
const { name, asin, query = name, bestFor, rank, criteria = [], pros = [], cons = [] } = Astro.props;
const score = criteria.length > 0 || Astro.props.score !== undefined
  ? overallScore(criteria, Astro.props.score)
  : undefined;
---
<aside class="product">
  <div class="top">
    <div class="info">
      {rank !== undefined && <span class="rank">#{rank} pick</span>}
      <p class="name">{name}</p>
      {bestFor && <p class="best"><span class="label">Best for</span><span>{bestFor}</span></p>}
      {score !== undefined && <Stars percent={score} />}
    </div>
    {score !== undefined && (
      <div class="score"><span class="num">{score}<sup>%</sup></span><span class="lbl">Score</span></div>
    )}
  </div>
  {criteria.length > 0 && <div class="bars"><ScoreBars criteria={criteria} /></div>}
  {(pros.length > 0 || cons.length > 0) && <div class="pcs"><ProsCons pros={pros} cons={cons} /></div>}
  <slot />
  <div class="cta">
    <AmazonButton asin={asin} query={asin ? undefined : query} />
    <span class="note">Opens Amazon · we may earn a commission</span>
  </div>
</aside>
<style>
  .product {
    position: relative; margin: 2.25rem 0; background: #fff; font-family: var(--font);
    border: 1px solid #e5e7eb; border-radius: 14px; overflow: hidden;
    box-shadow: 0 1px 2px rgb(17 24 39 / .04), 0 10px 30px rgb(17 24 39 / .07);
  }
  .product::before { content: ''; display: block; height: 5px; background: linear-gradient(90deg, var(--accent), #ff5a5f); }
  .top { display: flex; justify-content: space-between; gap: 1rem; padding: 1.3rem 1.4rem .9rem; }
  .rank {
    display: inline-block; margin-bottom: .5rem; padding: .2rem .6rem; border-radius: 999px;
    background: var(--accent); color: #fff; font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em;
  }
  .name {
    margin: 0 0 .5rem !important; font-family: var(--font-heading); font-weight: 700;
    font-size: clamp(1.3rem, 2.4vw, 1.6rem) !important; line-height: 1.25 !important; color: var(--heading-color) !important;
  }
  .best { display: flex; flex-wrap: wrap; align-items: baseline; gap: .5rem; margin: 0 0 .5rem !important; font-size: .92rem !important; line-height: 1.45 !important; color: #4b5563 !important; }
  .label {
    flex: none; padding: .15rem .55rem; border-radius: 6px; background: #fff1f1; color: var(--accent);
    font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em;
  }
  .score {
    flex: none; width: 4.6rem; height: 4.6rem; border-radius: 12px; background: var(--score); color: #fff;
    display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 6px 16px rgb(30 136 229 / .3);
  }
  .num { font-size: 1.4rem; font-weight: 700; line-height: 1; }
  .num sup { font-size: .5em; }
  .lbl { font-size: .55rem; text-transform: uppercase; letter-spacing: .08em; margin-top: .45rem; }
  .bars { padding: .2rem 1.4rem 0; }
  .pcs { padding: .3rem 1.4rem 0; }
  .cta {
    display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem;
    margin-top: 1.2rem; padding: 1rem 1.4rem 1.2rem; border-top: 1px solid #f1f2f4; background: #fafafa;
  }
  .note { font-size: .72rem; color: var(--muted); line-height: 1.4; }
  @media (max-width: 560px) {
    .top, .bars, .pcs, .cta { padding-left: 1rem; padding-right: 1rem; }
    .cta :global(.amazon) { width: 100%; justify-content: center; }
  }
</style>
