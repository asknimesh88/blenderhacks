---
// Pinned panel at the bottom of the post sidebar: reading progress,
// more articles to read next, and a buyer's-guide card.
import Thumb from './Thumb.astro';
import { postUrl, type Post } from '../lib/posts';
interface Props { current: Post; next: Post[]; }
const { current, next } = Astro.props;
const words = (current.body ?? '').replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 230));
const guide = '/blog/blender-types-explained/';
const showGuide = postUrl(current) !== guide;
---
<div class="sticky">
  <section class="progress" data-progress data-minutes={minutes}>
    <div class="row">
      <span class="lbl">Reading progress</span>
      <span class="pct" data-progress-text>{minutes} min read</span>
    </div>
    <div class="track"><span class="bar" data-progress-bar></span></div>
  </section>

  {next.length > 0 && (
    <section>
      <h3 class="section-title"><span class="plain">Keep</span>&nbsp;Reading</h3>
      <ul class="next">
        {next.map((p) => (
          <li>
            <a href={postUrl(p)}>
              <Thumb post={p} width="4.5rem" ratio="1 / 1" />
              <span><span class="cat">{p.data.category}</span><span class="t">{p.data.title}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {showGuide && (
    <a class="guide" href={guide}>
      <span class="kicker">Buyer's guide</span>
      <span class="gt">Which blender do you actually need?</span>
      <span class="gd">Personal, full-size or high-performance: find the right type before you buy.</span>
      <span class="go">Read the guide →</span>
    </a>
  )}
</div>
<script>
  const box = document.querySelector<HTMLElement>('[data-progress]');
  const article = document.querySelector<HTMLElement>('.main');
  if (box && article) {
    const bar = box.querySelector<HTMLElement>('[data-progress-bar]')!;
    const text = box.querySelector<HTMLElement>('[data-progress-text]')!;
    const total = Number(box.dataset.minutes) || 1;
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = article.getBoundingClientRect();
      const span = r.height - innerHeight;
      const p = Math.min(1, Math.max(0, span > 0 ? -r.top / span : 1));
      bar.style.width = `${Math.round(p * 100)}%`;
      const left = Math.ceil(total * (1 - p));
      text.textContent = p >= 0.99 ? 'Finished' : p <= 0.01 ? `${total} min read` : `${left} min left`;
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }
</script>
<style>
  .sticky { position: sticky; top: 1.5rem; display: flex; flex-direction: column; gap: 1.6rem; }
  .progress { border: 1px solid #e5e7eb; border-radius: 12px; padding: .9rem 1rem 1rem; background: #fff; box-shadow: 0 4px 16px rgb(17 24 39 / .05); }
  .row { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: .55rem; font-size: .72rem; }
  .lbl { font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--text); }
  .pct { color: var(--accent); font-weight: 600; }
  .track { height: 6px; border-radius: 999px; background: #f1f2f4; overflow: hidden; }
  .bar { display: block; height: 100%; width: 0; border-radius: inherit; background: linear-gradient(90deg, var(--accent), #ff5a5f); transition: width .15s linear; }
  .next { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .85rem; }
  .next a { display: flex; gap: .8rem; align-items: center; color: var(--text); }
  .next :global(.thumb) { border-radius: 8px; }
  .cat { display: block; font-size: .6rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--accent); margin-bottom: .15rem; }
  .t { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: .8rem; font-weight: 600; line-height: 1.4; }
  .next a:hover .t { color: var(--accent); }
  .guide {
    display: block; padding: 1.2rem 1.2rem 1.1rem; border-radius: 12px; color: #fff;
    background: linear-gradient(135deg, var(--heading-color) 0%, #3a0b0e 100%); box-shadow: 0 8px 24px rgb(17 24 39 / .18);
  }
  .guide:hover { color: #fff; }
  .kicker { display: inline-block; padding: .15rem .55rem; border-radius: 999px; background: var(--accent); font-size: .6rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
  .gt { display: block; margin: .6rem 0 .35rem; font-family: var(--font-heading); font-weight: 700; font-size: 1.35rem; line-height: 1.2; }
  .gd { display: block; font-size: .78rem; line-height: 1.5; color: rgb(255 255 255 / .75); }
  .go { display: inline-block; margin-top: .8rem; font-size: .75rem; font-weight: 700; color: #ffb3b6; }
  .guide:hover .go { color: #fff; }
  @media (max-width: 900px) { .sticky { position: static; } .progress { display: none; } }
  /* Keep the pinned panel shorter than the window on short screens. */
  @media (min-width: 901px) and (max-height: 780px) { .guide { display: none; } }
  @media (min-width: 901px) and (max-height: 600px) { .next, .sticky > section:has(.next) { display: none; } }
</style>
