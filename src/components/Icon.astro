---
// Small line icons used in section titles.
interface Props { name: string; }
const paths: Record<string, string> = {
  star: 'M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z',
  cart: 'M3 4h2l2.4 10.5h10.8L20.5 7H6.3M9 19.5a1 1 0 1 0 0 .01M17 19.5a1 1 0 1 0 0 .01',
  bulb: 'M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z',
  drop: 'M12 3s6 6.6 6 11a6 6 0 0 1-12 0c0-4.4 6-11 6-11z',
  cup: 'M6 7h12l-1.5 13.5h-9zM5 7h14M9 3.5l1.5 3.5M14.5 3l-1 4',
  bowl: 'M3 11h18a9 9 0 0 1-18 0zM8 21h8M12 3v5M8.5 5l1.5 3M15.5 5L14 8',
};
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={paths[name] ?? paths.star} /></svg>
