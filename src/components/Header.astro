---
import { SITE, CATEGORIES } from '../config';
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  ...CATEGORIES.map((c) => ({ href: `/category/${c.slug}/`, label: c.name })),
];
---
<header class="site-header" data-header>
  <div class="container bar">
    <a class="logo" href="/" aria-label={`${SITE.name} home`}>
      <img src="/logo.svg" alt="" width="42" height="42" />
      <span>Blender<b>Hacks</b></span>
    </a>
    <nav aria-label="Main">
      {links.map((l) => <a href={l.href} class:list={{ active: path === l.href }}>{l.label}</a>)}
    </nav>
    <a class="icon" href="/rss.xml" aria-label="RSS feed">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="5" cy="19" r="2.5" fill="currentColor"/><path d="M3 10.5a10.5 10.5 0 0 1 10.5 10.5M3 3.5A17.5 17.5 0 0 1 20.5 21" fill="none" stroke="currentColor" stroke-width="3"/></svg>
    </a>
  </div>
</header>
<script>
  // Add a shadow once the page has scrolled under the sticky header.
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const update = () => header.classList.toggle('scrolled', scrollY > 8);
    addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgb(255 255 255 / .96); backdrop-filter: saturate(1.4) blur(8px); -webkit-backdrop-filter: saturate(1.4) blur(8px);
    border-bottom: 1px solid var(--border); transition: box-shadow .2s;
  }
  .site-header.scrolled { box-shadow: 0 4px 18px rgb(17 24 39 / .08); }
  /* Logo left, menu centered, RSS right */
  .bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 2rem; min-height: var(--header-h); }
  .logo { justify-self: start; display: flex; align-items: center; gap: .6rem; color: var(--text); font-size: 1.25rem; font-weight: 500; letter-spacing: -.01em; }
  .logo b { font-weight: 800; color: var(--accent); }
  nav { display: flex; flex-wrap: wrap; justify-content: center; gap: .3rem 1.6rem; }
  nav a { white-space: nowrap; color: var(--text); font-size: .72rem; font-weight: 600; text-transform: uppercase; letter-spacing: .02em; }
  nav a:hover { color: var(--accent); }
  nav a.active { background: var(--bg-soft); color: var(--text); padding: .45rem .8rem; margin: -.45rem -.8rem; border-radius: 4px; }
  .icon { justify-self: end; color: var(--text); display: flex; }
  .icon:hover { color: var(--accent); }
  @media (max-width: 1100px) { .bar { gap: 1.2rem; } nav { gap: .3rem 1.1rem; } }
  @media (max-width: 900px) {
    .bar { grid-template-columns: 1fr auto; gap: .4rem 1rem; padding-block: .55rem .45rem; min-height: 0; }
    nav { grid-column: 1 / -1; grid-row: 2; justify-content: flex-start; flex-wrap: nowrap; overflow-x: auto; padding-bottom: .25rem; scrollbar-width: none; }
    nav::-webkit-scrollbar { display: none; }
    nav a.active { margin: 0; padding: .1rem .5rem; }
    .logo img { width: 34px; height: 34px; }
    .logo { font-size: 1.1rem; }
  }
</style>
