---
import { SITE, AMAZON_DISCLOSURE } from '../config';
import { getPosts, postUrl, tagSlug } from '../lib/posts';
import Thumb from './Thumb.astro';
import FormattedDate from './FormattedDate.astro';

const posts = await getPosts();
const recent = posts.slice(0, 2);
const counts = new Map<string, number>();
posts.flatMap((p) => p.data.tags).forEach((t) => counts.set(t, (counts.get(t) ?? 0) + 1));
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 14).map(([t]) => t);
const year = new Date().getFullYear();
---
<footer>
  <div class="container cols">
    <section>
      <h4>About Us</h4>
      <p>{SITE.description} <a href="/about/">Learn more</a>.</p>
      <p class="small">{AMAZON_DISCLOSURE} <a href="/affiliate-disclosure/">Affiliate disclosure</a>.</p>
    </section>
    <section>
      <h4>Popular Tags</h4>
      <div class="tags">{tags.map((t) => <a href={`/tag/${tagSlug(t)}/`}>{t}</a>)}</div>
    </section>
    <section>
      <h4>Recent Posts</h4>
      {recent.map((p) => (
        <a class="recent" href={postUrl(p)}>
          <Thumb post={p} width="6rem" />
          <span><span class="t">{p.data.title}</span><span class="d"><FormattedDate date={p.data.pubDate} /></span></span>
        </a>
      ))}
    </section>
  </div>
  <div class="container bottom">
    <p>© {year} {SITE.name}. All rights reserved.</p>
    <nav aria-label="Footer">
      <a href="/about/">About</a>
      <a href="/affiliate-disclosure/">Affiliate Disclosure</a>
      <a href="/privacy/">Privacy Policy</a>
      <a href="/contact/">Contact</a>
    </nav>
  </div>
</footer>
<style>
  footer { background: var(--bg-soft); font-size: .82rem; margin-top: 1rem; }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 2rem 3rem; padding-block: 3rem 2rem; }
  h4 { color: var(--accent); font-size: .95rem; font-weight: 600; margin: 0 0 1rem; }
  p { margin: 0 0 .8rem; }
  .small { font-size: .75rem; color: var(--muted); }
  .tags { display: flex; flex-wrap: wrap; gap: .4rem; }
  .tags a { background: #e9e9e9; color: var(--body); font-size: .7rem; padding: .3rem .6rem; letter-spacing: .03em; }
  .tags a:hover { background: var(--accent); color: #fff; }
  .recent { display: flex; gap: .8rem; color: var(--text); margin-bottom: .9rem; align-items: flex-start; }
  .recent .t { display: block; line-height: 1.4; }
  .recent:hover .t { color: var(--accent); }
  .recent .d { display: block; font-size: .7rem; color: var(--muted); margin-top: .2rem; }
  .bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 1rem; border-top: 1px solid #e3e3e3; padding-block: 1.2rem 1.6rem; font-size: .75rem; }
  .bottom p { margin: 0; color: var(--muted); }
  .bottom nav { display: flex; flex-wrap: wrap; gap: .3rem 1rem; }
  .bottom a { color: var(--text); }
  .bottom a:hover { color: var(--accent); }
</style>
