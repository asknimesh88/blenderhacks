---
import { SITE, AMAZON_DISCLOSURE } from '../config';
import { getPosts, postUrl, tagSlug } from '../lib/posts';
import Thumb from './Thumb.astro';
import FormattedDate from './FormattedDate.astro';

const posts = await getPosts();
const recent = posts.slice(0, 2);
const counts = new Map<string, number>();
posts.flatMap((p) => p.data.tags).forEach((t) => counts.set(t, (counts.get(t) ?? 0) + 1));
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 14).map(([t]) => t);
const year = new Date().getFullYear();
---
<footer>
  <div class="container cols">
    <section>
      <a class="brand" href="/" aria-label={`${SITE.name} home`}>
        <img src="/logo.svg" alt="" width="40" height="40" loading="lazy" />
        <span>Blender<b>Hacks</b></span>
      </a>
      <p>{SITE.description} <a href="/about/">Learn more</a>.</p>
      <p class="small">{AMAZON_DISCLOSURE} <a href="/affiliate-disclosure/">Affiliate disclosure</a>.</p>
    </section>
    <section>
      <h4>Popular Tags</h4>
      <div class="tags">{tags.map((t) => <a href={`/tag/${tagSlug(t)}/`}>{t}</a>)}</div>
    </section>
    <section>
      <h4>Recent Posts</h4>
      {recent.map((p) => (
        <a class="recent" href={postUrl(p)}>
          <Thumb post={p} width="6rem" />
          <span><span class="t">{p.data.title}</span><span class="d"><FormattedDate date={p.data.pubDate} /></span></span>
        </a>
      ))}
    </section>
  </div>
  <div class="container bottom">
    <p>© {year} <span class="name">{SITE.name}</span>. All rights reserved.</p>
    <nav aria-label="Footer">
      <a href="/about/">About</a>
      <a href="/affiliate-disclosure/">Affiliate Disclosure</a>
      <a href="/privacy/">Privacy Policy</a>
      <a href="/contact/">Contact</a>
    </nav>
  </div>
</footer>
<style>
  footer {
    --f-bg: #0d0d0f; --f-text: #b4b8c0; --f-muted: #7d828c; --f-line: rgb(255 255 255 / .09);
    --f-red: #ff4b55; /* brighter red for small text on black (readable contrast) */
    position: relative; background: var(--f-bg); color: var(--f-text); font-size: .85rem; margin-top: 1.5rem;
  }
  footer::before { content: ''; display: block; height: 4px; background: linear-gradient(90deg, var(--accent), #ff5a5f, var(--accent)); }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 2.5rem 3.5rem; padding-block: 3.5rem 2.5rem; }
  h4 {
    position: relative; margin: .4rem 0 1.4rem; padding-bottom: .7rem;
    font-family: var(--font-heading); font-weight: 700; font-size: 1.35rem; letter-spacing: .03em; text-transform: uppercase; color: var(--accent);
  }
  h4::after { content: ''; position: absolute; left: 0; bottom: 0; width: 2.5rem; height: 3px; border-radius: 2px; background: var(--accent); }
  .brand { display: inline-flex; align-items: center; gap: .6rem; margin-bottom: 1.1rem; color: #fff; font-size: 1.35rem; font-weight: 500; }
  .brand b { font-weight: 800; color: var(--f-red); }
  .brand:hover { color: #fff; }
  p { margin: 0 0 .9rem; line-height: 1.75; }
  a { color: var(--f-red); }
  a:hover { color: #fff; }
  .small { font-size: .75rem; color: var(--f-muted); }
  .tags { display: flex; flex-wrap: wrap; gap: .45rem; }
  .tags a {
    padding: .38rem .7rem; border-radius: 6px; border: 1px solid var(--f-line); background: rgb(255 255 255 / .04);
    color: var(--f-text); font-size: .72rem; letter-spacing: .02em; transition: background .15s, border-color .15s, color .15s;
  }
  .tags a:hover { background: var(--accent); border-color: var(--accent); color: #fff; }
  .recent { display: flex; gap: .9rem; color: #fff; margin-bottom: 1.1rem; align-items: flex-start; }
  .recent :global(.thumb) { border-radius: 8px; }
  .recent .t { display: block; line-height: 1.45; font-weight: 500; transition: color .15s; }
  .recent:hover .t { color: var(--f-red); }
  .recent .d { display: block; font-size: .7rem; color: var(--f-muted); margin-top: .3rem; }
  .bottom { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .6rem 1rem; border-top: 1px solid var(--f-line); padding-block: 1.3rem 1.7rem; font-size: .75rem; }
  .bottom p { margin: 0; color: var(--f-muted); }
  .bottom .name { color: #fff; font-weight: 600; }
  .bottom nav { display: flex; flex-wrap: wrap; gap: .3rem 1.4rem; }
  .bottom nav a { color: var(--f-text); }
  .bottom nav a:hover { color: var(--f-red); }
</style>
