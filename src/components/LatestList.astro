---
// "Latest" list: image left, title, stars/byline, excerpt, Read more.
import Thumb from './Thumb.astro';
import Byline from './Byline.astro';
import { postUrl, type Post } from '../lib/posts';
interface Props { posts: Post[]; }
const { posts } = Astro.props;
---
<div class="list">
  {posts.map((p) => (
    <article class="item">
      <a class="img" href={postUrl(p)} tabindex="-1" aria-hidden="true">
        <Thumb post={p} ratio="7 / 5" />
        <span class="cat">{p.data.category}</span>
      </a>
      <div>
        <h3><a href={postUrl(p)}>{p.data.title}</a></h3>
        <Byline post={p} />
        <p class="excerpt">{p.data.description}</p>
        <a class="more" href={postUrl(p)}>Read more</a>
      </div>
    </article>
  ))}
</div>
<style>
  .item { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.4rem; margin-bottom: 2rem; }
  .img { display: block; position: relative; }
  .cat { position: absolute; left: .5rem; top: .5rem; background: var(--accent); color: #fff; font-size: .66rem; font-weight: 600; text-transform: uppercase; padding: .1rem .45rem; }
  h3 { font-size: 1.3rem; font-weight: 700; line-height: 1.3; letter-spacing: -.02em; margin: 0; }
  h3 a { color: var(--text); }
  h3 a:hover { color: var(--accent); }
  .excerpt { font-size: 1rem; line-height: 1.7; color: #4b5563; margin: 0 0 1.1rem; }
  .more { display: inline-block; border: 1px solid var(--border); color: var(--text); font-size: .72rem; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; padding: .5rem 1rem; border-radius: 6px; }
  .more:hover { background: var(--accent); border-color: var(--accent); color: #fff; }
  @media (max-width: 560px) { .item { grid-template-columns: 1fr; gap: .8rem; } h3 { font-size: 1.1rem; } }
</style>
