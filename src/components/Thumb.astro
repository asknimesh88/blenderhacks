---
// Post thumbnail: the hero photo, or a branded placeholder when there isn't one.
import type { Post } from '../lib/posts';
interface Props { post: Post; width?: string; ratio?: string; }
const { post, width = '100%', ratio = '4 / 3' } = Astro.props;
const hero = post.data.hero;
---
{hero
  ? <img class="thumb" src={hero.src} alt="" loading="lazy" style={`width:${width};aspect-ratio:${ratio}`} />
  : <span class="thumb ph" aria-hidden="true" style={`width:${width};aspect-ratio:${ratio}`}><img src="/logo.svg" alt="" /></span>}
<style>
  .thumb { flex: none; object-fit: cover; display: block; }
  .ph { display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #2b2b2b, #4a4a4a); }
  .ph img { width: 28%; max-width: 3.5rem; opacity: .55; }
</style>
