---
import { render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import ProductBox from '../../components/ProductBox.astro';
import AmazonButton from '../../components/AmazonButton.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import PullQuote from '../../components/PullQuote.astro';
import { getPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
// Available in every post without an import.
const components = { ProductBox, AmazonButton, RelatedPosts, PullQuote };
---
<Post post={post}><Content components={components} /></Post>
