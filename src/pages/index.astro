---
import List from '../layouts/List.astro';
import { getPosts } from '../lib/posts';
import { SITE } from '../config';
const posts = (await getPosts()).slice(0, 12);
---
<List title={SITE.name} description={SITE.description} kicker="Latest" heading="Articles" posts={posts} crumbs={false}>
  <section class="intro" slot="top">
    <h1>Get more out of your blender.</h1>
    <p>{SITE.tagline} Smoother smoothies, faster cleanup, and no-nonsense help picking the right machine.</p>
  </section>
</List>
<style>
  .intro { border-bottom: 1px solid var(--border); padding: .5rem 0 1.8rem; margin-bottom: 2rem; }
  .intro h1 { font-size: clamp(1.9rem, 4.6vw, 2.8rem); font-weight: 700; letter-spacing: -.03em; margin: 0 0 .5rem; }
  .intro p { margin: 0; font-size: 1rem; font-weight: 300; max-width: 40rem; }
</style>
