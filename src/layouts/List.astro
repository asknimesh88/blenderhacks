---
// Archive pages (blog, categories, tags): Latest-style list + pagination + sidebar.
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LatestList from '../components/LatestList.astro';
import Pagination from '../components/Pagination.astro';
import Sidebar from '../components/Sidebar.astro';
import type { Post } from '../lib/posts';
interface Props {
  title: string;
  description: string;
  heading: string;
  kicker?: string;
  posts: Post[];
  page?: { current: number; last: number; base: string };
}
const { title, description, heading, kicker, posts, page } = Astro.props;
const href = (n: number) => (n === 1 ? page!.base : `${page!.base}${n}/`);
---
<Base title={title} description={description}>
  <div class="container">
    <Breadcrumbs items={[{ href: '/', label: 'Home' }, { label: heading }]} />
    <div class="layout">
      <section>
        <h1 class="section-title">{kicker && <span class="plain">{kicker}&nbsp;</span>}{heading}</h1>
        {posts.length > 0 ? <LatestList posts={posts} /> : <p>No articles here yet. Check back soon.</p>}
        {page && <Pagination current={page.current} last={page.last} href={href} />}
      </section>
      <Sidebar />
    </div>
  </div>
</Base>
<style>
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 20rem; gap: 2.5rem; align-items: start; }
  @media (max-width: 900px) { .layout { grid-template-columns: minmax(0, 1fr); } }
</style>
